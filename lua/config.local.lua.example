-- ┌──────────────────────────────────────────────────────────────────┐
-- │  ЛОКАЛЬНЫЕ НАСТРОЙКИ QUIK-СКРИПТА (НЕ КОММИТИТЬ!)                 │
-- └──────────────────────────────────────────────────────────────────┘
-- Скопируйте этот файл в lua/config.local.lua рядом со скриптом prices.lua
-- и подставьте свои значения.
--
-- Файл называется config.local.lua и добавлен в .gitignore, потому что
-- репозиторий публичный — токен в общий доступ не попадает.
--
-- Скрипт prices.lua ищет этот файл сам; если его нет — работает с
-- локальным сервером http://127.0.0.1:5000, как раньше.

return {
    -- Адрес сервера BrokerReport, без слэша на конце.
    --
    -- Вариант 1 — через Cloudflare Tunnel (нужна DNS-запись broker.roman-it.dev):
    --   api_base = "https://broker.roman-it.dev"
    --
    -- Вариант 2 — через SSH-туннель с машины QUIK (порт сервера наружу НЕ открыт).
    -- Сначала поднять туннель, затем указать его локальный конец:
    --   ssh -N -L 5180:127.0.0.1:5000 roman@78.17.114.178
    --   api_base = "http://127.0.0.1:5180"
    api_base = "https://broker.roman-it.dev",

    -- Токен доступа. Должен совпадать с API_TOKEN в .env на сервере.
    -- Сгенерировать на сервере:  sh deploy/init-secrets.sh
    api_token = "ВСТАВЬТЕ_СВОЙ_ТОКЕН",

    -- Таймаут одного запроса, секунды
    timeout = 15,

    -- Проверять TLS-сертификат сервера (по умолчанию включено).
    -- false отключает проверку — только для отладки: трафик с токеном
    -- пойдёт без защиты от подмены сертификата.
    verify_tls = true,

    -- Свой CA-бандл вместо lua_modules/share/lua/5.3/ssl/cacert.pem
    -- ca_file = "C:\\BrokerReport\\lua_modules\\share\\lua\\5.3\\ssl\\cacert.pem",
}
