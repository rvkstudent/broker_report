# ─────────────────────────────────────────────────────────────────────
#  BrokerReport: настройки сервера
#  Скопируйте в ../.env  (cp deploy/env.example .env) и заполните.
#  ВАЖНО: .env не коммитится — репозиторий публичный.
# ─────────────────────────────────────────────────────────────────────

# ── Вход в веб-интерфейс ─────────────────────────────────────────────
APP_USER=roman
# Хеш пароля здесь НЕ хранится: в нём есть знак $, а Docker Compose
# в env_file разворачивает $ как подстановку переменной и хеш портится.
# Хеш лежит в файле secrets/password_hash.txt (подключён в compose).
# Задать пароль: sh deploy/set-password.sh
#
# Если всё же задаёте хеш через .env (только для локальной отладки),
# удваивайте знак $, иначе вход не заработает:  APP_PASSWORD_HASH=pbkdf2:sha256:600000$$соль$$хеш

# ── Ключ подписи сессионных кук ──────────────────────────────────────
# Сгенерировать: sh deploy/init-secrets.sh
# Если не задан, приложение сделает временный ключ и сессии будут
# сбрасываться при каждом перезапуске.
FLASK_SECRET=

# ── Токен для QUIK ───────────────────────────────────────────────────
# Тот же токен нужно вписать в lua/config.local.lua на машине с QUIK.
API_TOKEN=

# ── Скринер акций: T-Invest API (Т-Банк) ─────────────────────────────
# Токен из личного кабинета T-Invest (достаточно доступа «только чтение»).
# Без него страница /screener работает, но данные не собираются.
# Универсум: auto — топ-N акций MOEX по обороту, либо список: SBER,GAZP,LKOH
TINKOFF_TOKEN=
# Сертификат invest-public-api.tinkoff.ru выдан УЦ Минцифры. Обычно корень
# подхватывается из хранилища ОС (пакет truststore). Если его там нет —
# укажите PEM с корневым сертификатом:
# TINKOFF_CA_BUNDLE=/app/secrets/tinkoff-ca.pem
# SCREENER_UNIVERSE=auto
# SCREENER_MAX_INSTRUMENTS=100
# SCREENER_POLL_SECONDS=30
# SCREENER_RPM=480                     # лимит сервиса котировок — 600/мин
# SCREENER_RETENTION_DAYS=3
# SCREENER_LARGE_TRADE_RUB=1000000
# SCREENER_MIN_SIGNAL_TURNOVER=1000000  # ниже этого оборота сигналы не выдаются

# ── Скринер: хранение ────────────────────────────────────────────────
# Сырые тики 10 дней (~5–10 ГБ на топ-100), дальше сворачиваются в минутки
SCREENER_RETENTION_DAYS=10
# Минутки — год истории для бэктестов и графиков (~1–3 ГБ)
SCREENER_BAR_RETENTION_DAYS=365
# Дивидендные бумаги: стоп не применяется (выход по цели или времени)
SCREENER_NO_STOP_TICKERS=SBER,GAZP,LKOH,ROSN,TATN,MTSS,SNGSP
# Отдельный файл БД (по умолчанию screener.db рядом с broker.db)
# SCREENER_DB_PATH=

# ── Мастер-токен старой админ-панели устройств ───────────────────────
# Whitelist устройств отключён (DISABLE_DEVICE_AUTH=true), но токен
# всё равно нужно сменить: значение по умолчанию admin123 известно всем.
ADMIN_TOKEN=

# ── Cloudflare Tunnel ────────────────────────────────────────────────
# Токен туннеля для broker.roman-it.dev (Cloudflare → Zero Trust → Tunnels).
BROKER_TUNNEL_TOKEN=

# ── Параметры авторизации (необязательно) ────────────────────────────
# Срок жизни сессии, часы (30 суток по умолчанию)
SESSION_HOURS=720
# Попыток входа до временной блокировки IP
LOGIN_MAX_ATTEMPTS=10
# Окно подсчёта попыток, секунды
LOGIN_WINDOW=300
