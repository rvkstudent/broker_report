# ─────────────────────────────────────────────────────────────────────
#  BrokerReport: настройки сервера
#  Скопируйте в ../.env  (cp deploy/env.example .env) и заполните.
#  ВАЖНО: .env не коммитится — репозиторий публичный.
# ─────────────────────────────────────────────────────────────────────

# ── Вход в веб-интерфейс ─────────────────────────────────────────────
APP_USER=roman
# Хеш пароля здесь НЕ хранится: в нём есть знак $, а Docker Compose
# в env_file разворачивает $ как подстановку переменной и хеш портится.
# Хеш лежит в файле secrets/password_hash.txt (подключён в compose).
# Задать пароль: sh deploy/set-password.sh
#
# Если всё же задаёте хеш через .env (только для локальной отладки),
# удваивайте знак $, иначе вход не заработает:  APP_PASSWORD_HASH=pbkdf2:sha256:600000$$соль$$хеш

# ── Ключ подписи сессионных кук ──────────────────────────────────────
# Сгенерировать: sh deploy/init-secrets.sh
# Если не задан, приложение сделает временный ключ и сессии будут
# сбрасываться при каждом перезапуске.
FLASK_SECRET=

# ── Токен для QUIK ───────────────────────────────────────────────────
# Тот же токен нужно вписать в lua/config.local.lua на машине с QUIK.
API_TOKEN=

# ── Мастер-токен старой админ-панели устройств ───────────────────────
# Whitelist устройств отключён (DISABLE_DEVICE_AUTH=true), но токен
# всё равно нужно сменить: значение по умолчанию admin123 известно всем.
ADMIN_TOKEN=

# ── Cloudflare Tunnel ────────────────────────────────────────────────
# Токен туннеля для broker.roman-it.dev (Cloudflare → Zero Trust → Tunnels).
BROKER_TUNNEL_TOKEN=

# ── Параметры авторизации (необязательно) ────────────────────────────
# Срок жизни сессии, часы (30 суток по умолчанию)
SESSION_HOURS=720
# Попыток входа до временной блокировки IP
LOGIN_MAX_ATTEMPTS=10
# Окно подсчёта попыток, секунды
LOGIN_WINDOW=300
